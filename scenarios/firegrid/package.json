    "echo": "tsx src/emitters/echo.ts",
    "echo-receiver": "tsx src/receivers/echo-receiver.ts",
    "failing-operation": "tsx src/emitters/failing-operation.ts",
    "failing-operation-receiver": "tsx src/receivers/failing-operation-receiver.ts",
    "sleep": "tsx src/emitters/sleep.ts",
    "sleep-receiver": "tsx src/receivers/sleep-receiver.ts",
    "sleep-receiver:self-test": "tsx src/receivers/sleep-receiver.ts --self-test",
    "scheduled-work": "tsx src/emitters/scheduled-work.ts",
